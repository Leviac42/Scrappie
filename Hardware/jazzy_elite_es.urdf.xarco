<?xml version="1.0"?>
<robot name="jazzy_elite_es" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="base_length" value="0.88"/>
  <xacro:property name="base_width"  value="0.58"/>
  <xacro:property name="base_height" value="0.30"/>

  <xacro:property name="drive_wheel_radius" value="0.1143"/>
  <xacro:property name="drive_wheel_width"  value="0.07"/>
  <xacro:property name="wheel_separation"   value="0.50"/>

  <xacro:property name="caster_radius" value="0.0762"/>
  <xacro:property name="caster_width"  value="0.05"/>
  <xacro:property name="caster_offset_x" value="-0.65"/>
  <xacro:property name="caster_separation" value="0.45"/>

  <xacro:property name="mount_offset_x" value="0.1524"/> 
  <xacro:property name="cam_offset_z" value="0.0762"/>   
  <xacro:property name="us_offset_z" value="0.1524"/>    

  <xacro:property name="d435_length" value="0.025"/>
  <xacro:property name="d435_width"  value="0.090"/>
  <xacro:property name="d435_height" value="0.025"/>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12}" iyz="0"
               izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12}" iyz="0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${drive_wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="${-base_length/2 + 0.1} 0 ${base_height/2 - 0.05}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="${-base_length/2 + 0.1} 0 ${base_height/2 - 0.05}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="40.0" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <xacro:macro name="drive_wheel" params="prefix reflect">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${drive_wheel_radius}" length="${drive_wheel_width}"/>
        </geometry>
        <material name="black">
          <color rgba="0 0 0 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${drive_wheel_radius}" length="${drive_wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="5.0" r="${drive_wheel_radius}" h="${drive_wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="0 ${reflect * wheel_separation / 2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="caster_wheel" params="prefix reflect">
    <link name="${prefix}_caster">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${caster_radius}" length="${caster_width}"/>
        </geometry>
        <material name="grey">
          <color rgba="0.5 0.5 0.5 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${caster_radius}" length="${caster_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="1.0" r="${caster_radius}" h="${caster_width}"/>
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster"/>
      <origin xyz="${caster_offset_x} ${reflect * caster_separation / 2} ${caster_radius - drive_wheel_radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel prefix="front_left"  reflect="1"/>
  <xacro:drive_wheel prefix="front_right" reflect="-1"/>
  <xacro:caster_wheel prefix="rear_left"  reflect="1"/>
  <xacro:caster_wheel prefix="rear_right" reflect="-1"/>

  <xacro:macro name="us_sensor" params="name parent xyz rpy">
    <link name="${name}_link">
      <visual>
        <geometry>
          <box size="0.02 0.04 0.02"/>
        </geometry>
        <material name="blue">
          <color rgba="0 0 1 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="0.02 0.04 0.02"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
  </xacro:macro>

  <xacro:us_sensor name="us_front_left" parent="base_link" 
                   xyz="0 ${wheel_separation/2} ${us_offset_z}" 
                   rpy="0 0 ${pi/2}"/>
  <xacro:us_sensor name="us_front_right" parent="base_link" 
                   xyz="0 ${-wheel_separation/2} ${us_offset_z}" 
                   rpy="0 0 ${-pi/2}"/>

  <xacro:us_sensor name="us_rear_left" parent="base_link" 
                   xyz="${caster_offset_x} ${caster_separation/2} ${(caster_radius - drive_wheel_radius) + us_offset_z}" 
                   rpy="0 0 ${pi/2}"/>
  <xacro:us_sensor name="us_rear_right" parent="base_link" 
                   xyz="${caster_offset_x} ${-caster_separation/2} ${(caster_radius - drive_wheel_radius) + us_offset_z}" 
                   rpy="0 0 ${-pi/2}"/>

  <xacro:macro name="d435_camera" params="name xyz rpy">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${d435_length} ${d435_width} ${d435_height}"/>
        </geometry>
        <material name="aluminum">
          <color rgba="0.8 0.8 0.8 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="${d435_length} ${d435_width} ${d435_height}"/>
        </geometry>
      </collision>
      <xacro:box_inertia m="0.072" x="${d435_length}" y="${d435_width}" z="${d435_height}"/>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="${name}_depth_optical_frame"/>
    <joint name="${name}_optical_joint" type="fixed">
      <parent link="${name}_link"/>
      <child link="${name}_depth_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>
  </xacro:macro>

  <xacro:d435_camera name="camera_front" 
                     xyz="${mount_offset_x} 0 ${cam_offset_z}" 
                     rpy="0 0 0"/>

  <xacro:d435_camera name="camera_rear" 
                     xyz="${caster_offset_x - mount_offset_x} 0 ${(caster_radius - drive_wheel_radius) + cam_offset_z}" 
                     rpy="0 0 ${pi}"/>

</robot>